{
  "name": "@tracegate/cli",
  "version": "0.5.1",
  "description": "Command line interface for running TraceGate matrix tests.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ducminhle1904/TraceGate.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ducminhle1904/TraceGate/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/ducminhle1904/TraceGate/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "evals",
    "cli",
    "replay",
    "ci"
  ],
  "bin": {
    "tracegate": "./dist/bin/tracegate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @tracegate/core build && tsc -p tsconfig.json",
    "type-check": "pnpm --filter @tracegate/core build && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm --filter @tracegate/core build && vitest run"
  },
  "dependencies": {
    "@tracegate/core": "workspace:0.5.1",
    "jiti": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
