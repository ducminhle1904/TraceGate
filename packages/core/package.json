{
  "name": "@tracegate/core",
  "version": "0.3.0",
  "description": "Core contracts, schemas, and policy primitives for TraceGate.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ducminhle1904/TraceGate.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ducminhle1904/TraceGate/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ducminhle1904/TraceGate/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "tool-calls",
    "guardrails",
    "evals",
    "replay"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cjs": {
      "types": "./cjs/index.d.cts",
      "require": "./cjs/index.cjs",
      "default": "./cjs/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "cjs": [
        "cjs/index.d.ts"
      ],
      "cjs/index": [
        "cjs/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "cjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
