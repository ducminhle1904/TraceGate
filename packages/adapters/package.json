{
  "name": "@tracegate/adapters",
  "version": "0.0.1",
  "description": "Framework adapters and observability exports for TraceGate.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ducminhle1904/TraceGate.git",
    "directory": "packages/adapters"
  },
  "homepage": "https://github.com/ducminhle1904/TraceGate/tree/main/packages/adapters#readme",
  "bugs": {
    "url": "https://github.com/ducminhle1904/TraceGate/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "openai",
    "langgraph",
    "opentelemetry",
    "evals"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openai-agents": {
      "types": "./dist/openai-agents.d.ts",
      "import": "./dist/openai-agents.js"
    },
    "./langgraph": {
      "types": "./dist/langgraph.d.ts",
      "import": "./dist/langgraph.js"
    },
    "./opentelemetry": {
      "types": "./dist/opentelemetry.d.ts",
      "import": "./dist/opentelemetry.js"
    },
    "./braintrust": {
      "types": "./dist/braintrust.d.ts",
      "import": "./dist/braintrust.js"
    },
    "./langfuse": {
      "types": "./dist/langfuse.d.ts",
      "import": "./dist/langfuse.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @tracegate/core build && tsc -p tsconfig.json",
    "type-check": "pnpm --filter @tracegate/core build && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm --filter @tracegate/core build && vitest run"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@openai/agents": "^0.11.6",
    "@opentelemetry/api": "^1.9.1",
    "@tracegate/core": "workspace:*",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.6",
    "@langfuse/otel": "^5.4.1",
    "@langfuse/tracing": "^5.4.1",
    "@openai/agents": "^0.11.6",
    "@opentelemetry/api": "^1.9.1",
    "braintrust": "^3.17.0"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph": {
      "optional": true
    },
    "@langfuse/otel": {
      "optional": true
    },
    "@langfuse/tracing": {
      "optional": true
    },
    "braintrust": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/langgraph": "^1.3.6",
    "@langfuse/otel": "^5.4.1",
    "@langfuse/tracing": "^5.4.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@types/node": "^24.10.1",
    "braintrust": "^3.17.0"
  }
}
