{
  "name": "tracegate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ducminhle1904/TraceGate.git"
  },
  "homepage": "https://github.com/ducminhle1904/TraceGate#readme",
  "bugs": {
    "url": "https://github.com/ducminhle1904/TraceGate/issues"
  },
  "scripts": {
    "build": "pnpm -r --if-present --filter './packages/*' build",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "examples:check": "pnpm --filter tracegate-example-basic-tool-policy test:matrix && pnpm --filter tracegate-example-basic-tool-policy test:replay && pnpm --filter tracegate-example-replay-failure test:replay && pnpm --filter tracegate-example-openai-agents start && pnpm --filter tracegate-example-langgraph-js start",
    "lint": "biome check --files-ignore-unknown=true .",
    "type-check": "pnpm -r --if-present --filter './packages/*' type-check",
    "test": "pnpm -r --if-present --filter './packages/*' test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.15"
  }
}
